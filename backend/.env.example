# Application
PROJECT_NAME=CrimeGPT
ENVIRONMENT=development

# Security - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (PostgreSQL in production, SQLite for local development)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/crimegpt

# CORS (comma separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# AI - optional. Without a key the platform uses the built-in rule-based engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
